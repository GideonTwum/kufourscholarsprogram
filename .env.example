# ============================
# Copy to `.env.local` for local development.
# Set the same vars in Vercel (or your host) for production.
# ============================

# --- Supabase (Dashboard → Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only: never expose in the browser / client bundles
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Public site URL (auth redirects, invite links) ---
# Production example: https://scholars.yourdomain.com
# Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Transactional email (Resend — https://resend.com) ---
# Required for applicant/director notification emails in production.
#
# 1. Create a Resend account and API key (Dashboard → API Keys).
# 2. Verify your sending domain (Dashboard → Domains) — required for production.
# 3. Set EMAIL_FROM to an address on that verified domain, e.g.:
#    EMAIL_FROM=Kufuor Scholars Program <noreply@yourdomain.com>
#
# Dev without a domain: you may use onboarding@resend.dev but Resend only
# delivers to the email on your Resend account until a domain is verified.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Kufuor Scholars Program <noreply@yourdomain.com>

# --- Optional: Supabase Edge Function `send-email` ---
# If deployed, the app tries Edge first, then falls back to direct Resend above.
# Set these secrets in Supabase (Dashboard → Edge Functions → send-email → Secrets):
#   RESEND_API_KEY=...
#   EMAIL_FROM=...
#   SUPABASE_SERVICE_ROLE_KEY=...  (already available to functions by default in some setups)
#
# Deploy from project root:
#   npx supabase functions deploy send-email --project-ref YOUR_PROJECT_REF
#
# If the function is NOT deployed, direct Resend from Next.js still works when
# RESEND_API_KEY is set in .env.local / Vercel.

# --- Director signup (self-serve `/director/signup`) ---
# Generate a long random secret for each environment. Never use this placeholder.
DIRECTOR_SIGNUP_CODE=replace_with_a_long_random_secret
# Legacy fallback:
# DIRECTOR_REGISTRATION_CODE=alternative_code

# --- Test email (directors only) ---
# UI:  http://localhost:3000/director/email-tests  (sidebar → Email test)
# API: POST /api/director/email-test  (send)  GET /api/director/email-test  (config only)

# --- Auth email (Supabase — NOT the vars above) ---
# Signup verification, resend verification, and panel invites are sent by Supabase Auth.
# Configure in the Supabase Dashboard (confirm email, redirect URLs, optional Resend SMTP).
# Full guide: docs/AUTH-EMAIL-SETUP.md

# --- Future Clerk auth migration ---
# Do not set these in production until the Clerk migration branch is fully tested.
# Clerk should own auth/invite emails after migration; Resend should still handle
# application workflow emails. See docs/CLERK-AUTH-EMAIL-PLAN.md.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxx
# CLERK_SECRET_KEY=sk_live_xxxxx
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxx
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/applicant-register
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/applicant
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/applicant
